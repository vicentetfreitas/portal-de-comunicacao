#########################################
# APPLICATION
#########################################

APP_NAME=portal-comunicacao
APP_ENV=local

#########################################
# SERVER
#########################################

SERVER_PORT=8080

#########################################
# DATABASE
#########################################

SPRING_DATASOURCE_URL=
# Usuário de aplicação (DEC-DB-024 / INFRA-DB-01). Nunca utilizar UNMPORTCOM (schema owner).
SPRING_DATASOURCE_USERNAME=UNMPORTCOM_APP
SPRING_DATASOURCE_PASSWORD=
# Obrigatório para mvn test (perfil test, DEC-DB-023): mesmo Oracle provisionado pelo DBA.

#########################################
# JPA
#########################################

# Qualificador Hibernate do schema owner (tabelas/sequences). Distinto do usuário JDBC.
SPRING_JPA_PROPERTIES_HIBERNATE_DEFAULT_SCHEMA=UNMPORTCOM

# Sessão JDBC para UNMPORTCOM_APP (DEC-DB-024). Necessário para validação Hibernate e DML no owner.
ORACLE_SESSION_CURRENT_SCHEMA_SQL=ALTER SESSION SET CURRENT_SCHEMA = UNMPORTCOM

#########################################
# SECURITY
#########################################

APPLICATION_SECURITY_JWT_SECRET=
APPLICATION_SECURITY_ACCESS_TOKEN_EXPIRATION=900
APPLICATION_SECURITY_REFRESH_TOKEN_EXPIRATION=28800

#########################################
# AUTH (FT-AUTH)
#########################################

AUTH_FRONTEND_REDIRECT_URL=http://localhost:9000/app
AUTH_LOGIN_PAGE_URL=http://localhost:9000/auth

#########################################
# ZIMBRA (FT-AUTH — validação de credenciais IMAP / SMTP / SOAP)
#########################################
# Referência legado: docs/discovery/05-current-integrations.md (Zimbra IMAP/SMTP/SOAP)

ZIMBRA_IMAP_HOST=mail-app.unimedceara.com.br
ZIMBRA_IMAP_PORT=993
ZIMBRA_IMAP_SSL=true

ZIMBRA_SMTP_HOST=mail-app.unimedceara.com.br
ZIMBRA_SMTP_PORT=587
ZIMBRA_SMTP_SSL=false
ZIMBRA_SMTP_STARTTLS=true

ZIMBRA_SOAP_URL=https://mail-app.unimedceara.com.br/service/soap
ZIMBRA_TIMEOUT_MS=10000

#########################################
# LOGGING
#########################################

LOG_LEVEL=INFO
