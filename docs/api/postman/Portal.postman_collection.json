{
  "info": {
    "name": "Portal de Comunicação — API v1 (Validation)",
    "description": "Sprint API-VALIDATION-01 — 58 casos com scripts pm.test. Helpers: validation-helpers.js",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "2.0.0"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Response time < 5000ms', function () {",
          "    pm.expect(pm.response.responseTime).to.be.below(5000);",
          "});"
        ]
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "apiPrefix", "value": "/api/v1" },
    { "key": "access_token", "value": "" },
    { "key": "xsrf_token", "value": "" },
    { "key": "singularId", "value": "1" },
    { "key": "areaId", "value": "1" },
    { "key": "equipeId", "value": "1" },
    { "key": "colaboradorId", "value": "1" },
    { "key": "sessionId", "value": "" }
  ],
  "item": [
    {
      "name": "01 — Health",
      "item": [
        {
          "name": "[POS] GET Health — 200 ApiResponse",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                "const j = pm.response.json();",
                "pm.test('ApiResponse envelope', () => {",
                "    pm.expect(j.success).to.be.true;",
                "    pm.expect(j).to.have.property('timestamp');",
                "    pm.expect(j.data.status).to.eql('UP');",
                "    pm.expect(j.data.application).to.eql('portal-comunicacao');",
                "});"
              ]
            }
          }],
          "request": { "method": "GET", "url": "{{baseUrl}}{{apiPrefix}}/health" }
        }
      ]
    },
    {
      "name": "02 — Authentication (Negative)",
      "item": [
        {
          "name": "[NEG] GET Me — 401 sem cookie",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('HTTP 401', () => pm.response.to.have.status(401));",
                "const j = pm.response.json();",
                "pm.test('ErrorResponse', () => {",
                "    pm.expect(j.error).to.eql('UNAUTHORIZED');",
                "    pm.expect(j).to.have.property('path');",
                "});"
              ]
            }
          }],
          "request": { "method": "GET", "url": "{{baseUrl}}{{apiPrefix}}/auth/me" }
        },
        {
          "name": "[NEG] POST Refresh — 401 sem refresh cookie",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('HTTP 401 or 403', () => pm.expect(pm.response.code).to.be.oneOf([401, 403]));"
              ]
            }
          }],
          "request": { "method": "POST", "url": "{{baseUrl}}{{apiPrefix}}/auth/refresh" }
        },
        {
          "name": "[NEG] GET Callback — 400 state inválido",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('HTTP 4xx', () => pm.expect(pm.response.code).to.be.within(400, 499));"
              ]
            }
          }],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}{{apiPrefix}}/auth/callback?token=x&state=invalid", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","callback"], "query": [{"key":"token","value":"x"},{"key":"state","value":"invalid"}] }
          }
        }
      ]
    },
    {
      "name": "02 — Authentication (Positive)",
      "description": "Requer cookies após login Zimbra — importar access_token e xsrf_token nas variáveis",
      "item": [
        {
          "name": "[POS] GET Me — 200 com cookie",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "if (pm.response.code === 200) {",
                "    const j = pm.response.json();",
                "    pm.test('AuthenticatedUserResponse', () => {",
                "        pm.expect(j.success).to.be.true;",
                "        pm.expect(j.data).to.have.property('id');",
                "        pm.expect(j.data).to.have.property('email');",
                "        pm.expect(j.data).to.have.property('sessionId');",
                "        pm.expect(j.data.permissions).to.be.an('array');",
                "    });",
                "    if (j.data.sessionId) pm.collectionVariables.set('sessionId', j.data.sessionId);",
                "} else { pm.test.skip('Cookie não configurado — importar após login'); }"
              ]
            }
          }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Cookie", "value": "access_token={{access_token}}" }],
            "url": "{{baseUrl}}{{apiPrefix}}/auth/me"
          }
        },
        {
          "name": "[POS] POST Logout — 204",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "if (pm.collectionVariables.get('access_token')) {",
                "    pm.test('HTTP 204', () => pm.response.to.have.status(204));",
                "} else { pm.test.skip('Requer cookies'); }"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Cookie", "value": "access_token={{access_token}}; XSRF-TOKEN={{xsrf_token}}" },
              { "key": "X-XSRF-TOKEN", "value": "{{xsrf_token}}" }
            ],
            "url": "{{baseUrl}}{{apiPrefix}}/auth/logout"
          }
        }
      ]
    },
