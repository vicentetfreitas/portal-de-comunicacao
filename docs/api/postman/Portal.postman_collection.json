              "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));"] } }],
              "request": {
                "method": "PATCH",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Cookie", "value": "access_token={{access_token}}" },
                  { "key": "X-XSRF-TOKEN", "value": "{{xsrf_token}}" }
                ],
                "body": { "mode": "raw", "raw": "{ \"status\": \"INACTIVE\" }" },
                "url": "{{baseUrl}}{{apiPrefix}}/colaboradores/{{colaboradorId}}/status"
              }
            }
          ]
        },
        {
          "name": "Negative",
          "item": [
