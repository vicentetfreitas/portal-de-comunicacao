{
  "name": "frontend",
  "version": "0.0.1",
  "private": true,
  "description": "Portal de Comunicação — Frontend Foundation (Quasar/Vue 3)",
  "author": "Vicente Freitas <vicenteteixeirafreitas@gmail.com>",
  "type": "module",
  "scripts": {
    "lint": "oxfmt && oxlint --fix",
    "lint:check": "oxfmt --check && oxlint",
    "dev": "quasar dev",
    "build": "quasar build",
    "typecheck": "vue-tsc --noEmit",
    "test": "yarn typecheck && vitest run --coverage",
    "test:unit": "vitest run --coverage",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium --with-deps",
    "test:validate": "bash scripts/validate-fe-s0-09.sh",
    "postinstall": "quasar prepare --silent"
  },
  "dependencies": {
    "@quasar/extras": "^2.0.0",
    "axios": "^1.13.2",
    "pinia": "^3.0.1",
    "quasar": "^2.21.1",
    "vue": "^3.5.22",
    "vue-i18n": "^11.1.2",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@quasar/app-vite": "^3.0.0",
    "@quasar/vite-plugin": "^1.10.0",
    "@types/node": "^22.19.11",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "^3.2.4",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.27",
    "happy-dom": "^18.0.1",
    "oxfmt": "^0.x",
    "oxlint": "^1.x",
    "oxlint-tsgolint": "^0.x",
    "postcss": "^8.5.6",
    "typescript": "^6.0.0",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.3.3"
  },
  "engines": {
    "node": ">= 22.12"
  },
  "packageManager": "yarn@1.22.22",
  "productName": "Portal de Comunicação"
}
